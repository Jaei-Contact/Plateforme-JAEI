# ============================================================
# JAEI Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Base de données PostgreSQL (fournie par Render) ──────────
DATABASE_URL=postgresql://user:password@host:5432/jaei

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=remplacer_par_une_chaine_aleatoire_longue_et_securisee

# ── Frontend (URL de production) ─────────────────────────────
FRONTEND_URL=https://jaei.org

# ── Email SMTP (Infomaniak) ───────────────────────────────────
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@jaei-journal.org
SMTP_PASS=mot_de_passe_boite_infomaniak
SMTP_FROM=contact@jaei-journal.org
ADMIN_EMAIL=contact@jaei-journal.org

# ── Cloudinary (stockage PDFs et avatars) ────────────────────
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

SUBMISSION_FEE_XAF=100000

# ── Stripe (paiements — choix client, voir docs/PAIEMENTS-PREPARATION.md) ──
# Obtenir sur : https://dashboard.stripe.com > Developers > API keys
# Le compte Stripe doit être ouvert depuis un pays supporté (pas le Cameroun).
# STRIPE_WEBHOOK_SECRET : Developers > Webhooks > endpoint /api/payments/stripe/webhook
# Laisser vide en dev = mode simulation automatique
STRIPE_SECRET_KEY=votre_cle_secrete_stripe
STRIPE_WEBHOOK_SECRET=votre_webhook_signing_secret

# ── Taux de change (affichage uniquement, Commentaire 2 client) ─
# Combien vaut 1 XAF dans chaque devise. Mis à jour manuellement,
# aucun appel API de change externe. Laisser vide = devise masquée.
# Exemple (ordres de grandeur, À VÉRIFIER avant mise en prod) :
#   FX_RATE_XAF_TO_USD=0.00165
#   FX_RATE_XAF_TO_EUR=0.00152
#   FX_RATE_XAF_TO_CAD=0.00225
FX_RATE_XAF_TO_USD=
FX_RATE_XAF_TO_EUR=
FX_RATE_XAF_TO_CAD=

# ── Facturation ───────────────────────────────────────────────
# URL publique du backend, utilisée pour les liens de facture PDF
# quand Cloudinary n'est pas configuré (fallback disque local).
BACKEND_URL=http://localhost:5000

# ── Google Gemini (IA résumés) ────────────────────────────────
GEMINI_API_KEY=votre_cle_gemini
